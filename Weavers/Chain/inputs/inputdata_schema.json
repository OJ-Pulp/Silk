{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "Designations": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                "^[A-Z]$": {
                    "type": "object",
                    "properties": {
                        "Type": {
                            "type": [
                                "string",
                                "null"
                            ]
                        },
                        "Number of Parts": {
                            "type": [
                                "integer",
                                "null"
                            ]
                        },
                        "Vital Parts": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        },
                        "Parts": {
                            "type": "object",
                            "minProperties": 1,
                            "additionalProperties": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "minItems": 1
                            }
                        }
                    },
                    "required": [
                        "Vital Parts",
                        "Parts"
                    ],
                    "additionalProperties": false
                }
            }
        },
        "Manufacturers": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "properties": {
                        "ID": {
                            "type": "string",
                            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                        },
                        "Locations": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            },
                            "minItems": 1
                        }
                    },
                    "required": [
                        "Locations"
                    ],
                    "additionalProperties": false
                }
            }
        }
    },
    "required": [
        "Designations",
        "Manufacturers"
    ],
    "additionalProperties": false
}
